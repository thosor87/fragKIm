{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "npm install --workspaces --include-workspace-root",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{backend/dist/**,frontend/dist/**}",
      "excludeFiles": "{**/node_modules/@huggingface/**,**/node_modules/@qdrant/**,**/node_modules/onnxruntime-*/**,**/node_modules/sharp/**,**/.onnx,**/*.onnx}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
