# Provider-Schalter (Default: online + stub, null Setup nötig)
RETRIEVAL_PROVIDER=online       # online | local
EMBEDDING_PROVIDER=local        # local | mistral   (nur relevant bei RETRIEVAL_PROVIDER=local)
LLM_PROVIDER=stub               # stub | ollama | mistral
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Nur nötig, wenn ein Provider auf "mistral" steht
MISTRAL_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM    # Rachel (multilingual, default)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Grundschulwiki-Archiv (siehe github.com/thosor87/grundschulwiki-archiv).
# Wird ab Juni 2026 die Live-API ersetzen, weil die ZUM abschaltet.
# Default: raw-GitHub des Public-Repos. Setze "off" wenn Archive deaktiviert
# sein soll (dann fällt grundschulwiki wieder auf die Live-API zurück).
GRUNDSCHULWIKI_ARCHIVE_URL=https://raw.githubusercontent.com/thosor87/grundschulwiki-archiv/main/data

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=klexikon

DEMO_PASSWORD=change-me
NODE_ENV=development
PUBLIC_DEMO_BANNER=true
PORT=8080

# Klexikon-Crawler
CRAWLER_CONTACT=hallo@example.org   # E-Mail in den User-Agent für ZUM-Admins
